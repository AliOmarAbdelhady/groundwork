# GroundWork configuration — copy to .env and adjust.
# All values can also be set as GW_* environment variables.

# --- generation ---------------------------------------------------------
# local (llama.cpp + Qwen2.5-3B, fully offline) | openai_compatible
GW_LLM_PROVIDER=local
GW_OPENAI_BASE_URL=https://api.openai.com/v1
GW_OPENAI_API_KEY=
GW_OPENAI_MODEL=gpt-4o-mini

# --- retrieval (server defaults) ---------------------------------------
GW_DENSE_TOP_K=30
GW_SPARSE_TOP_K=30
GW_RRF_K=60
GW_RERANK_ENABLED=true
GW_FINAL_TOP_K=6
GW_GROUNDING_THRESHOLD=0.52

# --- serving ------------------------------------------------------------
GW_API_HOST=127.0.0.1
GW_API_PORT=8000
# production: point at a Qdrant server instead of embedded local mode
# GW_QDRANT_URL=http://localhost:6333
